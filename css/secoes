#imagemPerfilUsuario {
  margin-top: -1em;
}

textarea {
  resize: none;
  background: var(--textarea);
}

/* Tema claro */

:root,
[data-bs-theme="light"] {
  --menu-primary: #0d6efd;
  --menu-primary-hover: #0b5ed7;

  --textarea: white;

  --menu-navbar: #0b2545;

  --menu-bg: #f5f7fb;
  --menu-surface: #ffffff;

  --menu-text: #212529;
  --menu-text-secondary: #6c757d;

  --menu-border: #dbe5f1;

  --menu-shadow: rgba(0, 0, 0, 0.08);
}

/* Tema */

[data-bs-theme="dark"] {
  --menu-primary: #4da3ff;
  --menu-primary-hover: #218cff;

  --textarea: rgb(152, 148, 148);

  --menu-navbar: #000000;

  --menu-bg: #121212;
  --menu-surface: #1e1e1e;

  --menu-text: #ffffff;
  --menu-text-secondary: #bdbdbd;

  --menu-border: #303030;

  --menu-shadow: rgba(0, 0, 0, 0.45);
}

body {
  background: var(--menu-bg);

  color: var(--menu-text);

  transition: 0.3s ease; /* controla a transição*/
}

/*Navbar, logo e botão de três linhas*/

.sb-topnav {
  background: var(--menu-navbar) !important;

  min-height: 75px;

  box-shadow: 0 4px 15px var(--menu-shadow);
}

.navbar-brand {
  font-weight: 700;

  color: #fff !important;

  display: flex;

  align-items: center;

  gap: 0.7rem;
}

#sidebarToggle {
  color: white;

  font-weight: 600;

  letter-spacing: 0.8px;
}

/* Dropdown, parte do perfil e opções de tema*/
.dropdown-menu {
  background: var(--menu-surface);

  border: 1px solid var(--menu-border);

  border-radius: 15px;

  overflow: hidden;

  box-shadow: 0 8px 20px var(--menu-shadow);
}

.dropdown-header {
  color: var(--menu-text-secondary);
}

.dropdown-item {
  color: var(--menu-text);

  transition: 0.25s;
}

.dropdown-item:hover {
  background: var(--menu-primary);

  color: white;
}

.dropdown-item.active {
  background: var(--menu-primary);

  color: white;
}

/*Lupa*/
#gerenciamentoSecaoLupa {
  color: white;
}

/* barra de pesquisa*/
#pesquisarSecao {
  background-color: var(--menu-surface);

  color: var(--menu-text);

  border: 1px solid var(--menu-border);

  border-radius: 12px;

  min-height: 52px;
}

#pesquisarSecao::placeholder {
  color: var(--menu-text-secondary);
}

#pesquisarSecao:focus {
  border-color: var(--menu-primary);

  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.2);
}

/*Cadastro exemplar*/

#adicionarSecao {
  background-color: var(--menu-primary);

  border: none;

  color: white;

  border-radius: 12px;

  transition: 0.2s ease;
}

#adicionarSecao:hover {
  background-color: var(--menu-primary-hover);

  transform: translateY(-2px);
}

/*Fichas*/

.card {
  background: var(--menu-surface);

  border: 1px solid var(--menu-border);

  border-radius: 18px;

  box-shadow: 0 6px 20px var(--menu-shadow);
}

.card-body {
  background: transparent;

  color: var(--menu-text);
}

/*Div resultado pesquisa*/

#resultadoPesquisa {
  cursor: pointer;
}

#resultadoPesquisa .border {
  border: 1px solid var(--menu-border) !important;

  border-radius: 16px !important;

  transition: 0.3s ease;
}

#resultadoPesquisa .border:hover {
  border-color: var(--menu-primary) !important;

  transform: translateY(-2px);

  box-shadow: 0 5px 18px var(--menu-shadow);
}

/* Imagem do exemplar */

#resultadoPesquisa img {
  border: 2px solid var(--menu-primary);

  object-fit: cover;

  transition: 0.3s;
}

#resultadoPesquisa img:hover {
  transform: scale(1.05); /* quanto deve alterar o tamamnho da imagem*/
}

/*Fonte das Fichas */

#resultadoPesquisa h5 {
  color: var(--menu-text);

  font-weight: 600;
}

#resultadoPesquisa p {
  color: var(--menu-text-secondary);
}

/*quando for o tema escuro, aplica a cor da variavel*/

[data-bs-theme="dark"] .text-muted {
  color: var(--menu-text-secondary) !important;
}

[data-bs-theme="dark"] h5 {
  color: white !important;
}

/* Botões presentes nos cards */

.btn-success {
  background: var(--menu-primary);
  border: none;
}

.btn-success:hover {
  background: var(--menu-primary-hover);
}

.btn-primary {
  background: var(--menu-primary);

  border: none;
}

.btn-primary:hover {
  background: var(--menu-primary-hover);
}

.btn-danger {
  border: none;
}

/* Modais */

.modal-content {
  background: var(--menu-surface);

  color: var(--menu-text);

  border: 1px solid var(--menu-border);

  border-radius: 20px;
}

.modal-header {
  border-bottom: 1px solid var(--menu-border);
}

.modal-footer {
  border-top: 1px solid var(--menu-border);
}

.modal-title {
  color: var(--menu-text);
}

/* Formularios */

.form-label {
  color: var(--menu-text);

  font-weight: 600;
}

.form-control {
  background: var(--menu-surface);

  color: var(--menu-text);

  border: 1px solid var(--menu-border);

  border-radius: 12px;
}

.form-control::placeholder {
  color: var(--menu-text-secondary);
}

.form-control:focus {
  color: var(--menu-text);

  background: var(--menu-surface);

  border-color: var(--menu-primary);

  box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.2);
}

/*quando for tema claro, aplica as cores ao texto de  */

[data-bs-theme="dark"] .form-control {
  color: white;
}

/* inverte a cor do botão fechar */

[data-bs-theme="dark"] .btn-close {
  filter: invert(1);
}
